<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23000"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="SegmentedTabsView" customModule="AppEventTracker" customModuleProvider="target">
            <connections>
                <outlet property="button1" destination="btn-1" id="out-btn1"/>
                <outlet property="button2" destination="btn-2" id="out-btn2"/>
                <outlet property="contentView" destination="tabs-container-id" id="out-container"/>
                <outlet property="indicator" destination="indicator-id" id="out-indicator"/>
                <outlet property="stack" destination="stack-id" id="out-stack"/>
                <outlet property="trackLine" destination="trackLine-id" id="out-track"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="tabs-container-id">
            <rect key="frame" x="0.0" y="0.0" width="361" height="40"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" translatesAutoresizingMaskIntoConstraints="NO" id="stack-id">
                    <rect key="frame" x="0.0" y="0.0" width="361" height="33"/>
                    <subviews>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-1">
                            <rect key="frame" x="0.0" y="0.0" width="180.66666666666666" height="33"/>
                            <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                            <inset key="imageEdgeInsets" minX="0.0" minY="0.0" maxX="2.2250738585072014e-308" maxY="0.0"/>
                            <state key="normal" title="IN PROGRESS"/>
                        </button>
                        <button opaque="NO" tag="1" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-2">
                            <rect key="frame" x="180.66666666666663" y="0.0" width="180.33333333333337" height="33"/>
                            <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                            <inset key="imageEdgeInsets" minX="0.0" minY="0.0" maxX="2.2250738585072014e-308" maxY="0.0"/>
                            <state key="normal" title="FAILED / RETRYING"/>
                        </button>
                    </subviews>
                </stackView>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="trackLine-id">
                    <rect key="frame" x="0.0" y="39" width="361" height="1"/>
                    <color key="backgroundColor" systemColor="separatorColor"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="1" id="track-h"/>
                    </constraints>
                </view>
                <view contentMode="scaleToFill" ambiguous="YES" translatesAutoresizingMaskIntoConstraints="NO" id="indicator-id">
                    <rect key="frame" x="0.0" y="38" width="180" height="3"/>
                    <color key="backgroundColor" systemColor="systemBlueColor"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="3" id="ind-h"/>
                    </constraints>
                </view>
            </subviews>
            <viewLayoutGuide key="safeArea" id="tabs-safe-area"/>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="stack-id" firstAttribute="top" secondItem="tabs-container-id" secondAttribute="top" id="st-c1"/>
                <constraint firstItem="stack-id" firstAttribute="leading" secondItem="tabs-container-id" secondAttribute="leading" id="st-c2"/>
                <constraint firstAttribute="trailing" secondItem="stack-id" secondAttribute="trailing" id="st-c3"/>
                <constraint firstItem="trackLine-id" firstAttribute="top" secondItem="stack-id" secondAttribute="bottom" constant="6" id="tr-c1"/>
                <constraint firstItem="trackLine-id" firstAttribute="leading" secondItem="tabs-container-id" secondAttribute="leading" id="tr-c2"/>
                <constraint firstAttribute="trailing" secondItem="trackLine-id" secondAttribute="trailing" id="tr-c3"/>
                <constraint firstAttribute="bottom" secondItem="trackLine-id" secondAttribute="bottom" id="tr-c4"/>
                <constraint firstItem="indicator-id" firstAttribute="centerY" secondItem="trackLine-id" secondAttribute="centerY" id="ind-c1"/>
            </constraints>
            <freeformSimulatedSizeMetrics key="simulatedDestinationMetrics"/>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </view>
    </objects>
    <resources>
        <systemColor name="separatorColor">
            <color red="0.23529411764705882" green="0.23529411764705882" blue="0.2627450980392157" alpha="0.28999999999999998" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
        <systemColor name="systemBlueColor">
            <color red="0.0" green="0.47843137254901963" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
    </resources>
</document>
